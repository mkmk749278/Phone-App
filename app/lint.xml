<?xml version="1.0" encoding="UTF-8"?>
<lint>
    <!--
        AAPT2 will not resolve an adaptive launcher icon from a bare `mipmap-anydpi` folder,
        so the `-v26` qualifier is required even though minSdk is 29 and lint believes it is
        redundant. The check stays enabled everywhere else, where it is correct.
    -->
    <issue id="ObsoleteSdkInt">
        <ignore path="src/main/res/mipmap-anydpi-v26" />
    </issue>

    <!--
        Dependency versions are pinned deliberately in gradle/libs.versions.toml and bumped
        as a considered change, not whenever a newer artifact appears upstream.
    -->
    <issue id="GradleDependency" severity="informational" />
    <issue id="AndroidGradlePluginVersion" severity="informational" />
</lint>
